# Copy to docker/.env — read by compose.yaml

OPTIONSTRAT_EMAIL=you@example.com
OPTIONSTRAT_PASSWORD=yourpassword
OPTIONSTRAT_ACCOUNT_ID=your-account-uuid

# publish.sh uploads to S3 and invalidates CloudFront. The key needs s3:ListBucket,
# s3:PutObject and s3:DeleteObject on the bucket, and cloudfront:CreateInvalidation.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Optional overrides
# S3_BUCKET=optionspread-heatmaps-billbaran
# CLOUDFRONT_DISTRIBUTION_ID=E3AR100VQDUFIT
